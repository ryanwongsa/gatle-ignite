"""The class must be called `Model`, and forward must return a dict: losses select by name."""

import torch.nn as nn


class Model(nn.Module):
    def __init__(self, in_dim=64, hidden=128, n_classes=10):
        # No **kwargs: a misspelled cfg.model_params key must be a TypeError, not ignored.
        super().__init__()
        self.net = nn.Sequential(nn.Linear(in_dim, hidden), nn.ReLU(), nn.Linear(hidden, n_classes))

    def forward(self, x):
        # `x` is a key of prep_batch's "model_input" dict, splatted in by name.
        return {"logits": self.net(x)}
