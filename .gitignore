__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
wandb/
.DS_Store

# Anchored: hatchling honours .gitignore, and a bare `data/` would drop gatle_ignite/data/.
/data/
/site/
/checkpoints/
examples/*/checkpoints*/

# A virtualenv in the checkout would make verify_compile.py report uncommitted changes.
/.venv/
/venv/

# Generated by docs/gen_reference.py at build time; tests/test_docs.py globs docs/**/*.md.
docs/reference/config.md
docs/reference/contracts.md
docs/reference/builtins.md
docs/getting-started/cli.md

# Also generated by docs/gen_reference.py.
docs/reference/where-things-go.md
